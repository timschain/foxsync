# GitHub Webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub API (for fetching PR/issue details)
GITHUB_TOKEN=ghp_...

# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Operator keypair (used to call the reputation contract)
# KEEP THIS SECRET — never commit to git
STELLAR_OPERATOR_SECRET=S...

# Deployed contract IDs (from deploy.sh output)
REPUTATION_CONTRACT_ID=C...
ESCROW_CONTRACT_ID=C...

# ── PostgreSQL (optional) ────────────────────────────────────────────────────
# When set, the service uses PostgreSQL instead of the local JSON file registry.
# Required for multi-instance / production deployments.
#
# For Docker Compose, this is wired automatically from the postgres service.
# For standalone deployments, set the connection string below:
#
# DATABASE_URL=postgresql://foxsync:secret@localhost:5432/foxsync

# PostgreSQL credentials (used by docker-compose.yml to spin up the DB)
POSTGRES_DB=foxsync
POSTGRES_USER=foxsync
POSTGRES_PASSWORD=change_me_in_production

# GrantFox API (optional — to sync contribution data to the platform)
GRANTFOX_API_URL=https://api.grantfox.xyz
GRANTFOX_API_KEY=your_api_key_here

# Optional: notify an external webhook when FoxPoints are successfully awarded on-chain
FOXPOINTS_AWARD_WEBHOOK_URL=https://hooks.example.com/foxpoints-awarded

# Optional Band Protocol REST endpoint to fetch price data (used to enrich webhook payloads)
# Example: https://api.bandchain.org (or your Band oracle gateway)
BAND_REST_URL=https://api.bandchain.org
# Which symbol to query from Band (default XLM)
BAND_PRICE_SYMBOL=XLM

# Server
PORT=3001
NODE_ENV=development
